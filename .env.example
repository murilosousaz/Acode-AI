DISCORD_BOT_TOKEN=""
MONGO_URI="mongodb://admin:admin@localhost:27017/?authSource=admin&directConnection=true"
MONGO_DB_NAME="acode-ai"

# Chave do Google AI Studio (aistudio.google.com/apikey) — usada só para
# gerar embeddings, na camada gratuita do Gemini.
GOOGLE_API_KEY=""

# Usados apenas pelo docker-compose.yml para subir o container do MongoDB local.
# Devem corresponder ao usuário/senha embutidos em MONGO_URI acima.
MONGO_ROOT_USERNAME="admin"
MONGO_ROOT_PASSWORD="admin"

# Chave da DeepSeek (platform.deepseek.com) — usada para o chat do bot.
DEEPSEEK_API_KEY=""

# Opcionais (têm valores padrão em src/infrastructure/config/settings.py)
DEEPSEEK_BASE_URL="https://api.deepseek.com"
# deepseek-v4-pro = modo "thinking", melhor qualidade de resposta.
# deepseek-v4-flash = mais rápido/barato, qualidade um pouco menor.
DEEPSEEK_CHAT_MODEL="deepseek-v4-pro"

GOOGLE_EMBEDDING_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
GOOGLE_EMBEDDING_MODEL="gemini-embedding-001"
# gemini-embedding-001 sai nativamente com 3072 dimensões, mas é truncado
# para bater com EMBEDDING_DIMENSIONS (parâmetro `dimensions` da chamada).
# Mantenha 768 pra não precisar recriar o índice vetorial do MongoDB.
EMBEDDING_DIMENSIONS=768
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
