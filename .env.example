# --- MongoDB ---
MONGO_URI="mongodb://admin:admin@localhost:27017/?authSource=admin&directConnection=true"
MONGO_DB_NAME="acode-ai"

# Usados apenas pelo docker-compose.yml para subir o MongoDB local.
# Devem corresponder ao usuário/senha embutidos em MONGO_URI acima.
MONGO_ROOT_USERNAME="admin"
MONGO_ROOT_PASSWORD="admin"

# --- API ---
# Chave exigida no header X-API-Key do upload de PDFs (POST /api/v1/documents).
# Gere uma com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Se ficar vazia, o upload fica desabilitado.
ADMIN_API_KEY=""
# Origens do frontend permitidas pelo CORS, separadas por vírgula.
CORS_ALLOW_ORIGINS="http://localhost:5173,http://localhost:3000"
# Tamanho máximo do PDF enviado (MB).
MAX_UPLOAD_MB=25

# --- Ollama (https://ollama.com) — modelos gratuitos rodando localmente ---
# Dentro do docker compose a API usa http://ollama:11434/v1 automaticamente.
OLLAMA_BASE_URL="http://localhost:11434/v1"
# Modelo de chat (ollama pull qwen2.5:7b). Máquina fraca: llama3.2:3b
OLLAMA_CHAT_MODEL="qwen2.5:7b"
# Modelo de embeddings (ollama pull nomic-embed-text) — 768 dimensões.
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"
OLLAMA_MAX_TOKENS=2048
# Tempo máximo esperando o Ollama (s); a 1ª chamada carrega o modelo e é mais lenta.
OLLAMA_TIMEOUT_SECONDS=180
# Deve bater com a saída do modelo de embeddings e com o índice vetorial do MongoDB.
EMBEDDING_DIMENSIONS=768

# --- Rate limit (por IP) ---
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
