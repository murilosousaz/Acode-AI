DISCORD_BOT_TOKEN=""
MONGO_URI="mongodb://admin:troque-esta-senha@mongodb:27017/?authSource=admin"
MONGO_DB_NAME="vestibot"
OPENAI_API_KEY=""

# Usados apenas pelo docker-compose.yml para subir o container do MongoDB local.
# Devem corresponder ao usuário/senha embutidos em MONGO_URI acima.
MONGO_ROOT_USERNAME="admin"
MONGO_ROOT_PASSWORD="troque-esta-senha"

# Opcionais (têm valores padrão em src/infrastructure/config/settings.py)
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
